{
	"name": "peer-vault-relay",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"test": "vitest run",
