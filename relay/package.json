		"deploy": "node scripts/deploy.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.2",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12",
		"wrangler": "^4.162.0"
	}
}
