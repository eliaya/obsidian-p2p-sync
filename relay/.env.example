# Copy this file to relay/.env (git-ignored) and fill in both values.
# Used only by `npm run setup` and `npm run deploy`. Never commit real values.

# Cloudflare dashboard > Workers & Pages > "Account ID" in the right sidebar.
CLOUDFLARE_ACCOUNT_ID=

# Dashboard > My Profile > API Tokens > Create Token > Create Custom Token.
# Permissions (all Account level, scope the token to this one account):
#   Account > Workers Scripts > Edit      (deploy, secrets, cron trigger)
#   Account > D1 > Edit                   (create database, apply migrations)
#   Account > Workers R2 Storage > Edit   (create bucket, lifecycle rule)
# Nothing else is needed. No Zone permissions, no Memberships/User Details
# (so `wrangler whoami` may not work with this token; the scripts do not call it).
CLOUDFLARE_API_TOKEN=
